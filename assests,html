<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
<title>Ganesha: Rise of the Vighnaharta</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Yatra+One&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --gold: #d9a441;
    --gold-bright: #f0c661;
    --indigo: #141033;
    --indigo-deep: #0a0818;
    --maroon: #4a1520;
    --forest: #16301f;
    --parchment: #ede2c8;
    --stone: #857459;
    --danger: #b3492f;
    --ok: #6a9c5c;
  }
  *{ box-sizing:border-box; }
  html,body{
    margin:0; padding:0; width:100%; height:100%; overflow:hidden;
    background:var(--indigo-deep);
    font-family:'Poppins',sans-serif;
    color:var(--parchment);
    -webkit-user-select:none; user-select:none;
  }
  #canvas-wrap{ position:fixed; inset:0; }
  canvas{ display:block; width:100%; height:100%; }

  .screen{
    position:fixed; inset:0;
    display:flex; align-items:center; justify-content:center;
    flex-direction:column;
    background:radial-gradient(ellipse at center, var(--indigo) 0%, var(--indigo-deep) 75%);
    z-index:50;
    transition:opacity .8s ease;
  }
  .screen.hidden{ opacity:0; pointer-events:none; }

  .glyph-row{
    display:flex; gap:18px; margin-bottom:28px; opacity:.55;
    font-size:22px; letter-spacing:6px; color:var(--gold);
  }

  h1.title{
    font-family:'Yatra One', cursive;
    font-size:clamp(34px, 6vw, 72px);
    color:var(--gold-bright);
    margin:0 0 6px 0;
    text-align:center;
    text-shadow:0 0 40px rgba(217,164,65,.35);
    letter-spacing:1px;
  }
  .subtitle{
    font-size:15px;
    letter-spacing:4px;
    color:var(--stone);
    margin-bottom:44px;
    text-transform:uppercase;
  }

  button.divine-btn{
    background:linear-gradient(180deg, var(--gold-bright), var(--gold));
    color:var(--indigo-deep);
    border:none;
    padding:16px 44px;
    font-family:'Poppins',sans-serif;
    font-weight:600;
    font-size:16px;
    border-radius:2px;
    cursor:pointer;
    letter-spacing:.5px;
    box-shadow:0 8px 24px rgba(217,164,65,.25);
    transition:transform .15s ease, box-shadow .15s ease;
  }
  button.divine-btn:hover{ transform:translateY(-2px); box-shadow:0 12px 30px rgba(217,164,65,.4); }
  button.divine-btn:active{ transform:translateY(0); }
  button.divine-btn:disabled{ opacity:.4; cursor:not-allowed; transform:none; }

  button.ghost-btn{
    background:transparent;
    border:1px solid rgba(237,226,200,.3);
    color:var(--parchment);
    padding:12px 28px;
    font-family:'Poppins',sans-serif;
    font-size:14px;
    border-radius:2px;
    cursor:pointer;
    margin-top:14px;
    letter-spacing:.5px;
  }
  button.ghost-btn:hover{ border-color:var(--gold); color:var(--gold-bright); }

  /* ---- Cinematic / story ---- */
  #cinematic{
    position:fixed; inset:0; z-index:60; background:#000;
    display:flex; align-items:center; justify-content:center;
  }
  #cinematic.hidden{ display:none; }
  .letterbox{ position:absolute; left:0; right:0; height:9vh; background:#000; z-index:2; }
  .letterbox.top{ top:0; } .letterbox.bottom{ bottom:0; }
  #cine-bg{
    position:absolute; inset:0;
    background:radial-gradient(ellipse at 50% 40%, var(--maroon) 0%, var(--indigo-deep) 70%);
    transition:background 1s ease;
  }
  #cine-text-wrap{
    position:relative; z-index:3; max-width:640px; padding:0 30px; text-align:center;
  }
  #cine-slide-label{
    font-family:'Yatra One',cursive; color:var(--gold-bright); font-size:22px; margin-bottom:14px;
    letter-spacing:1px;
  }
  #cine-text{
    font-size:17px; line-height:1.7; color:var(--parchment); font-weight:300;
  }
  #cine-hint{
    position:absolute; bottom:12vh; left:0; right:0; text-align:center;
    font-size:12px; letter-spacing:2px; color:var(--stone); z-index:3;
    text-transform:uppercase;
  }

  /* ---- Name entry ---- */
  #name-form{ display:flex; flex-direction:column; align-items:center; gap:16px; }
  #name-input{
    background:rgba(237,226,200,.08);
    border:1px solid rgba(217,164,65,.4);
    color:var(--parchment);
    padding:14px 20px;
    font-family:'Poppins',sans-serif;
    font-size:16px;
    text-align:center;
    border-radius:2px;
    width:280px;
    outline:none;
  }
  #name-input:focus{ border-color:var(--gold-bright); }
  #name-prompt{ font-size:15px; color:var(--stone); margin-bottom:6px; letter-spacing:.5px; }

  /* ---- toast ---- */
  #toast{
    position:fixed; top:14%; left:50%; transform:translate(-50%,-10px);
    background:rgba(10,8,24,.85);
    border:1px solid rgba(217,164,65,.4);
    padding:14px 28px;
    border-radius:3px;
    font-size:15px;
    color:var(--gold-bright);
    z-index:80;
    opacity:0;
    transition:opacity .4s ease, transform .4s ease;
    pointer-events:none;
    text-align:center;
    max-width:70vw;
  }
  #toast.show{ opacity:1; transform:translate(-50%,0); }

  /* ---- HUD ---- */
  #hud{ position:fixed; inset:0; z-index:30; pointer-events:none; display:none; }
  #hud.active{ display:block; }

  #hud-topleft{
    position:absolute; top:22px; left:22px;
    background:rgba(10,8,24,.55);
    border:1px solid rgba(217,164,65,.25);
    padding:12px 18px;
    border-radius:3px;
    min-width:220px;
  }
  #hud-name{ font-size:13px; color:var(--gold-bright); letter-spacing:1px; margin-bottom:8px; }
  .bar-row{ display:flex; align-items:center; gap:8px; margin-bottom:6px; }
  .bar-label{ font-size:10px; width:16px; color:var(--stone); }
  .bar-track{ flex:1; height:9px; background:rgba(255,255,255,.08); border-radius:5px; overflow:hidden; }
  .bar-fill{ height:100%; border-radius:5px; transition:width .25s ease; }
  .bar-fill.hp{ background:linear-gradient(90deg, var(--danger), #d9704f); }
  .bar-fill.power{ background:linear-gradient(90deg, #4d7fb0, #7fb0d9); }
  .bar-fill.dodge{ background:linear-gradient(90deg, var(--ok), #9cc98d); }

  #hud-topright{
    position:absolute; top:22px; right:22px;
    background:rgba(10,8,24,.55);
    border:1px solid rgba(217,164,65,.25);
    padding:10px 16px;
    border-radius:3px;
    font-size:12px;
    letter-spacing:.5px;
    color:var(--parchment);
    text-align:right;
  }
  #hud-topright .clue-count{ color:var(--gold-bright); font-weight:600; }

  #combo-display{
    position:absolute; bottom:16%; left:50%; transform:translateX(-50%) scale(.8);
    font-family:'Yatra One',cursive;
    font-size:38px;
    color:var(--gold-bright);
    text-shadow:0 0 20px rgba(217,164,65,.6);
    opacity:0;
    transition:opacity .2s ease, transform .2s ease;
  }
  #combo-display.show{ opacity:1; transform:translateX(-50%) scale(1); }
  #combo-milestone{
    position:absolute; bottom:22%; left:50%; transform:translateX(-50%);
    font-size:13px; letter-spacing:3px; text-transform:uppercase; color:var(--parchment);
    opacity:0; transition:opacity .3s ease;
  }
  #combo-milestone.show{ opacity:1; }

  #hud-controls{
    position:absolute; bottom:18px; left:22px;
    font-size:11px; line-height:1.8; color:rgba(237,226,200,.5);
    background:rgba(10,8,24,.4);
    padding:10px 14px;
    border-radius:3px;
  }

  #enemy-plate{
    position:absolute;
    transform:translate(-50%,-100%);
    text-align:center;
    display:none;
  }
  #enemy-plate .name{ font-size:11px; letter-spacing:1px; color:var(--parchment); margin-bottom:3px; text-shadow:0 1px 3px #000; }
  #enemy-plate .track{ width:90px; height:6px; background:rgba(0,0,0,.5); border-radius:4px; overflow:hidden; margin:0 auto; }
  #enemy-plate .fill{ height:100%; background:linear-gradient(90deg,#8c2f2f,#c94f4f); transition:width .2s ease; }

  #interact-prompt{
    position:absolute; bottom:32%; left:50%; transform:translateX(-50%);
    background:rgba(10,8,24,.7);
    border:1px solid rgba(217,164,65,.4);
    padding:8px 16px;
    border-radius:3px;
    font-size:13px;
    display:none;
  }
  #interact-prompt kbd{
    background:var(--gold); color:var(--indigo-deep); padding:2px 7px; border-radius:3px; font-weight:600; margin-right:6px;
  }

  #lore-overlay{
    position:fixed; inset:0; z-index:70; display:none;
    align-items:center; justify-content:center;
    background:rgba(5,4,12,.82);
  }
  #lore-box{
    max-width:520px; padding:38px 42px;
    border:1px solid rgba(217,164,65,.4);
    background:linear-gradient(180deg, rgba(20,16,51,.9), rgba(10,8,24,.9));
    text-align:center;
    border-radius:3px;
  }
  #lore-box h3{ font-family:'Yatra One',cursive; color:var(--gold-bright); font-size:22px; margin:0 0 14px 0; }
  #lore-box p{ font-size:15px; line-height:1.7; color:var(--parchment); font-weight:300; margin:0 0 22px 0; }

  #scope-note{
    position:fixed; bottom:14px; right:18px; z-index:35;
    font-size:10.5px; color:rgba(237,226,200,.35); max-width:260px; text-align:right; line-height:1.5;
    pointer-events:none;
  }
</style>
</head>
<body>

<div id="canvas-wrap"></div>

<!-- TITLE SCREEN -->
<div class="screen" id="title-screen">
  <div class="glyph-row">ॐ ‌ 卐 ‌ ॐ</div>
  <h1 class="title">Ganesha</h1>
  <div class="subtitle">Rise of the Vighnaharta</div>
  <button class="divine-btn" id="btn-begin">Begin</button>
  <button class="ghost-btn hidden" id="btn-continue">Continue Quest</button>
</div>

<!-- CINEMATIC -->
<div id="cinematic" class="hidden">
  <div id="cine-bg"></div>
  <div class="letterbox top"></div>
  <div class="letterbox bottom"></div>
  <div id="cine-text-wrap">
    <div id="cine-slide-label"></div>
    <div id="cine-text"></div>
  </div>
  <div id="cine-hint">Click to continue</div>
</div>

<!-- NAME ENTRY -->
<div class="screen hidden" id="name-screen">
  <div class="glyph-row">ॐ</div>
  <h1 class="title" style="font-size:clamp(24px,4vw,40px)">The Divine Quest Begins</h1>
  <div id="name-prompt">What is your name, brave seeker?</div>
  <form id="name-form">
    <input id="name-input" type="text" maxlength="18" placeholder="Enter your name" autocomplete="off" />
    <button type="submit" class="divine-btn">Start Divine Hunt</button>
  </form>
</div>

<div id="toast"></div>

<!-- HUD -->
<div id="hud">
  <div id="hud-topleft">
    <div id="hud-name">GANESHA</div>
    <div class="bar-row"><div class="bar-label">HP</div><div class="bar-track"><div class="bar-fill hp" id="bar-hp" style="width:100%"></div></div></div>
    <div class="bar-row"><div class="bar-label">Q</div><div class="bar-track"><div class="bar-fill power" id="bar-power" style="width:100%"></div></div></div>
    <div class="bar-row"><div class="bar-label">⇧</div><div class="bar-track"><div class="bar-fill dodge" id="bar-dodge" style="width:100%"></div></div></div>
  </div>
  <div id="hud-topright">
    <div>Sacred Forest — the Divine Hunt</div>
    <div>Clues found: <span class="clue-count" id="clue-count">0</span> / 1</div>
  </div>
  <div id="combo-display">COMBO ×0</div>
  <div id="combo-milestone"></div>
  <div id="enemy-plate"><div class="name" id="enemy-name">Forest Demon</div><div class="track"><div class="fill" id="enemy-hp-fill" style="width:100%"></div></div></div>
  <div id="interact-prompt"><kbd>E</kbd><span id="interact-label">Interact</span></div>
  <div id="hud-controls">
    WASD move · SPACE jump · SHIFT dodge · Mouse drag look<br/>
    LMB attack · RMB heavy attack · Q divine strike · E interact
  </div>
</div>

<div id="lore-overlay">
  <div id="lore-box">
    <h3 id="lore-title">Ancient Inscription</h3>
    <p id="lore-text"></p>
    <button class="divine-btn" id="lore-close">Continue</button>
  </div>
</div>

<div id="scope-note">Prototype build — Sacred Forest zone &amp; core systems. Additional zones, bosses, and full account-based save/sync are the next build phase.</div>

<script type="importmap">
