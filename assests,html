  const orb = new THREE.Mesh(new THREE.SphereGeometry(0.3,12,12), orbMat);
  orb.position.copy(pos).setY(1.4);
  scene.add(orb);
  return { pos, glow, orb };
}
const shrinePos = new THREE.Vector3(-14,0,-10);

