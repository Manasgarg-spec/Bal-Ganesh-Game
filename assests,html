/* ---------------- particles ---------------- */
const particles = [];
function spawnBurst(pos, color, count=10, big=false){
  for(let i=0;i<count;i++){
    const geo = new THREE.SphereGeometry(big?0.09:0.05, 6,6);
    const mat = new THREE.MeshBasicMaterial({ color, transparent:true, opacity:1 });
    const m = new THREE.Mesh(geo, mat);
    m.position.copy(pos);
    const dir = new THREE.Vector3((Math.random()-0.5),(Math.random())*1.2,(Math.random()-0.5)).normalize();
    const speed = (big?4:2.4) + Math.random()*2;
    scene.add(m);
    particles.push({ mesh:m, vel:dir.multiplyScalar(speed), life:0, maxLife:0.5+Math.random()*0.3 });
  }
}
function spawnRing(pos, color, maxR=3){
  const geo = new THREE.RingGeometry(0.1,0.3,32);
  const mat = new THREE.MeshBasicMaterial({ color, transparent:true, opacity:0.8, side:THREE.DoubleSide });
  const ring = new THREE.Mesh(geo, mat);
  ring.rotation.x = -Math.PI/2;
  ring.position.copy(pos).setY(0.05);
  scene.add(ring);
  particles.push({ mesh:ring, ring:true, life:0, maxLife:0.6, maxR });
}
function updateParticles(dt){
  for(let i=particles.length-1;i>=0;i--){
    const p = particles[i];
    p.life += dt;
    const t = p.life/p.maxLife;
    if(p.ring){
      const s = 1 + t*p.maxR;
      p.mesh.scale.set(s,s,s);
      p.mesh.material.opacity = 0.8*(1-t);
    } else {
      p.mesh.position.addScaledVector(p.vel, dt);
      p.vel.y -= dt*5;
      p.mesh.material.opacity = 1-t;
      const s = 1-t*0.5;
      p.mesh.scale.set(s,s,s);
    }
    if(t>=1){ scene.remove(p.mesh); particles.splice(i,1); }
  }
}

/* ---------------- combat ---------------- */
function attack(heavy){
  if(!state.enemy || !state.enemy.alive) return;
  if(state.attackCD > 0) return;
  state.attackCD = heavy ? 0.75 : 0.35;
  const toEnemy = new THREE.Vector3().subVectors(state.enemy.mesh.position, player.position);
  const dist = toEnemy.length();
  const range = heavy ? 3.2 : 2.4;
  const facing = new THREE.Vector3(Math.sin(player.rotation.y), 0, Math.cos(player.rotation.y));
  const dot = facing.dot(toEnemy.clone().normalize());
  if(dist <= range && dot > 0.15){
    const dmg = heavy ? 22 : 10;
    damageEnemy(dmg, heavy);
    state.combo++;
    state.comboTimer = 2.2;
    updateComboUI();
    if(heavy){
      state.enemy.mesh.position.addScaledVector(toEnemy.normalize(), 0.6);
      spawnRing(state.enemy.mesh.position, 0xf0c661, 3);
      spawnBurst(state.enemy.mesh.position.clone().setY(1.2), 0xf0c661, 16, true);
      triggerShake(0.25);
    } else {
      spawnBurst(state.enemy.mesh.position.clone().setY(1.2), 0xd9a441, 8);
    }
  } else {
    spawnBurst(player.position.clone().addScaledVector(facing,0.8).setY(1.1), 0x998866, 4);
  }
}

function damageEnemy(dmg, heavy){
  const en = state.enemy;
  en.hp = Math.max(0, en.hp - dmg);
  updateEnemyPlateHP();
  en.staggerT = heavy ? 0.5 : 0.2;
  en.state = 'stagger';
  if(en.hp <= 0 && en.alive){
    en.alive = false;
    en.state = 'defeated';
    document.getElementById('enemy-plate').style.display = 'none';
    spawnBurst(en.mesh.position.clone().setY(1.2), 0xffffff, 24, true);
    en.mesh.visible = false;
    dropClue(en.mesh.position.clone());
    showToast('Guardian defeated. Something glimmers where it fell.', 3000);
  }
}

let comboUIState = 0;
function updateComboUI(){
  const el = document.getElementById('combo-display');
  el.textContent = `COMBO ×${state.combo}`;
  el.classList.add('show');
  const milestone = document.getElementById('combo-milestone');
  let msg = null;
  if(state.combo === 5) msg = 'Power Combo';
  if(state.combo === 10) msg = 'Divine Strike';
  if(state.combo === 20) msg = 'Perfect Combo';
  if(msg){
    milestone.textContent = msg;
    milestone.classList.add('show');
    setTimeout(()=> milestone.classList.remove('show'), 1200);
  }
}

let shakeT = 0, shakeMag = 0;
function triggerShake(mag){ shakeT = 0.28; shakeMag = mag; }

/* ---------------- clue / lore ---------------- */
function dropClue(pos){
  const geo = new THREE.OctahedronGeometry(0.28,0);
  const mat = new THREE.MeshStandardMaterial({ color:0xf0c661, emissive:0xd9a441, emissiveIntensity:1.1 });
  const orb = new THREE.Mesh(geo, mat);
  orb.position.copy(pos).setY(1.1);
  scene.add(orb);
  state.cluePickup = orb;
}

function showLore(title, text){
  document.getElementById('lore-title').textContent = title;
  document.getElementById('lore-text').textContent = text;
  document.getElementById('lore-overlay').style.display = 'flex';
}
document.getElementById('lore-close').addEventListener('click', ()=>{
  document.getElementById('lore-overlay').style.display = 'none';
});

function collectClue(){
  scene.remove(state.cluePickup);
  state.cluePickup = null;
  save.cluesFound = Math.min(1, save.cluesFound + 1);
  writeSave(save);
  document.getElementById('clue-count').textContent = save.cluesFound;
  showLore('Clue Found', 'Where the river touches the ancient mountain, the first sign awaits. The sacred elephant sanctuary lies beyond the guardian\u2019s ground.');
  if(!save.powerUnlocked){
    save.powerUnlocked = true;
    writeSave(save);
    setTimeout(()=> showToast('Divine Power unlocked: press Q to unleash a Divine Strike.', 3600), 400);
  }
}

/* ---------------- Q ability ---------------- */
function useDivinePower(){
  if(state.qCD > 0) return;
  if(!save.powerUnlocked){ showToast('This power is not yet unlocked.', 1800); return; }
  if(state.power < 40) return;
  state.qCD = state.qCDMax;
  state.power -= 40;
  spawnRing(player.position, 0xf0c661, 5);
  spawnBurst(player.position.clone().setY(1.2), 0xf0c661, 30, true);
  triggerShake(0.35);
  if(state.enemy && state.enemy.alive){
    const dist = player.position.distanceTo(state.enemy.mesh.position);
    if(dist < 6){ damageEnemy(35, true); }
  }
}
function onKeyDownGame(e){
  if(!worldStarted) return;
  if(e.code === 'KeyQ') useDivinePower();
  if(e.code === 'Digit2' || e.code === 'Digit3' || e.code === 'Digit4') showToast('Divine power not yet unlocked.', 1500);
  if(e.code === 'KeyE') tryInteract();
  if(e.code === 'ShiftLeft' || e.code === 'ShiftRight') doDodge();
}

let dodgeVec = new THREE.Vector3();
let dodgeT = 0;
function doDodge(){
  if(state.dodgeCD > 0) return;
  state.dodgeCD = state.dodgeCDMax;
  const dir = getMoveVector();
  const facing = new THREE.Vector3(Math.sin(player.rotation.y),0,Math.cos(player.rotation.y));
  dodgeVec = (dir.lengthSq() > 0 ? dir : facing.clone().negate()).normalize().multiplyScalar(9);
  dodgeT = 0.25;
  state.invuln = 0.3;
  spawnBurst(player.position.clone().setY(0.6), 0xffffff, 10);
}

/* ---------------- interact ---------------- */
function tryInteract(){
  if(state.cluePickup && player.position.distanceTo(state.cluePickup.position) < 1.8){
    collectClue();
    return;
  }
  if(!state.shrineUsed && player.position.distanceTo(shrinePos) < 2.2){
    state.shrineUsed = true;
    showLore('Sacred Shrine', 'The forest remembers every seeker who has passed this way. Few return with the mountain\u2019s blessing.');
  }
}

/* ---------------- movement ---------------- */
function getMoveVector(){
  const forward = new THREE.Vector3(Math.sin(cameraYaw), 0, Math.cos(cameraYaw));
  const right = new THREE.Vector3(Math.sin(cameraYaw + Math.PI/2), 0, Math.cos(cameraYaw + Math.PI/2));
  const v = new THREE.Vector3();
  if(keys['KeyW']) v.add(forward);
  if(keys['KeyS']) v.sub(forward);
  if(keys['KeyD']) v.add(right);
  if(keys['KeyA']) v.sub(right);
  return v;
}

function updatePlayer(dt){
  const moveVec = getMoveVector();
  const speed = 5.2;
  if(dodgeT > 0){
    player.position.addScaledVector(dodgeVec, dt);
    dodgeT -= dt;
  } else if(moveVec.lengthSq() > 0){
    moveVec.normalize();
    player.position.addScaledVector(moveVec, speed*dt);
    const targetRot = Math.atan2(moveVec.x, moveVec.z);
    let diff = targetRot - player.rotation.y;
    diff = Math.atan2(Math.sin(diff), Math.cos(diff));
    player.rotation.y += diff * Math.min(1, dt*10);
    const bob = Math.sin(performance.now()*0.012)*0.06;
    player.userData.legL.position.z = bob;
    player.userData.legR.position.z = -bob;
  } else {
    player.userData.legL.position.z *= 0.8;
    player.userData.legR.position.z *= 0.8;
  }

  // jump / gravity
  if(keys['Space'] && playerMixerState.onGround){
    playerMixerState.vy = 6.2;
    playerMixerState.onGround = false;
  }
  playerMixerState.vy -= 16*dt;
  player.position.y += playerMixerState.vy*dt;
  if(player.position.y <= 0){
    player.position.y = 0;
    playerMixerState.vy = 0;
    playerMixerState.onGround = true;
  }

  // boundary
  const R = 95;
  const distFromCenter = Math.hypot(player.position.x, player.position.z);
  if(distFromCenter > R){
    player.position.x *= R/distFromCenter;
    player.position.z *= R/distFromCenter;
  }

  // weapon swing feedback
  if(state.attackCD > 0.2){
    player.userData.weapon.rotation.x = Math.sin((0.75-state.attackCD)*20)*0.6;
  } else {
    player.userData.weapon.rotation.x *= 0.8;
  }
}

/* ---------------- enemy AI ---------------- */
function updateEnemy(dt){
  const en = state.enemy;
  if(!en || !en.alive) return;
  const mesh = en.mesh;
  const toPlayer = new THREE.Vector3().subVectors(player.position, mesh.position);
  const dist = toPlayer.length();
  en.attackCD = Math.max(0, en.attackCD - dt);

  if(en.staggerT > 0){
    en.staggerT -= dt;
    en.state = 'stagger';
  } else if(dist < en.attackRange){
    en.state = 'attack';
  } else if(dist < en.detectRange){
    en.state = 'chase';
  } else {
    en.state = 'patrol';
  }

  if(en.state === 'chase'){
    const dir = toPlayer.clone().setY(0).normalize();
    mesh.position.addScaledVector(dir, en.speed*dt);
    mesh.rotation.y = Math.atan2(dir.x, dir.z);
  } else if(en.state === 'patrol'){
    const toTarget = new THREE.Vector3().subVectors(en.patrolTarget, mesh.position).setY(0);
    if(toTarget.length() < 0.5){
      en.patrolTarget = en.home.clone().add(new THREE.Vector3((Math.random()-0.5)*8,0,(Math.random()-0.5)*8));
    } else {
      toTarget.normalize();
      mesh.position.addScaledVector(toTarget, en.speed*0.5*dt);
      mesh.rotation.y = Math.atan2(toTarget.x, toTarget.z);
    }
  } else if(en.state === 'attack'){
    mesh.rotation.y = Math.atan2(toPlayer.x, toPlayer.z);
    if(en.attackCD <= 0){
      en.attackCD = 1.4;
      if(state.invuln <= 0){
        state.playerHP = Math.max(0, state.playerHP - 8);
        updateHPUI();
        triggerShake(0.15);
        spawnBurst(player.position.clone().setY(1.1), 0xb3492f, 6);
      }
    }
  }

  // enemy plate position
  const plate = document.getElementById('enemy-plate');
  const screenPos = toScreenPosition(mesh.position.clone().setY(2.6));
  if(screenPos.behind || dist > 40){
    plate.style.display = 'none';
  } else {
    plate.style.display = 'block';
    plate.style.left = screenPos.x + 'px';
    plate.style.top = screenPos.y + 'px';
  }
}
function updateEnemyPlateHP(){
  const pct = Math.max(0, (state.enemy.hp/state.enemy.maxHp)*100);
  document.getElementById('enemy-hp-fill').style.width = pct + '%';
}

function toScreenPosition(vec3){
  const v = vec3.clone().project(camera);
  const w = renderer.domElement.clientWidth/2;
  const h = renderer.domElement.clientHeight/2;
  return { x: v.x*w+w, y: -(v.y*h)+h, behind: v.z > 1 };
}

/* ---------------- HUD ---------------- */
function updateHPUI(){
  document.getElementById('bar-hp').style.width = Math.max(0,(state.playerHP/state.playerMaxHP)*100) + '%';
}
function updateResourceUI(){
  document.getElementById('bar-power').style.width = Math.max(0,(state.power/state.powerMax)*100) + '%';
  document.getElementById('bar-dodge').style.width = Math.max(0, (1 - state.dodgeCD/state.dodgeCDMax)*100) + '%';
}

function updateInteractPrompt(){
  const prompt = document.getElementById('interact-prompt');
  const label = document.getElementById('interact-label');
  if(state.cluePickup && player.position.distanceTo(state.cluePickup.position) < 1.8){
    prompt.style.display = 'block'; label.textContent = 'Pick up clue';
  } else if(!state.shrineUsed && player.position.distanceTo(shrinePos) < 2.2){
    prompt.style.display = 'block'; label.textContent = 'Read shrine inscription';
  } else {
    prompt.style.display = 'none';
  }
}

/* ---------------- camera ---------------- */
function updateCamera(){
  const targetPos = player.position.clone().add(new THREE.Vector3(0,1.4,0));
  let dist = camDistance;
  const offset = new THREE.Vector3(
    Math.sin(cameraYaw) * Math.cos(cameraPitch),
    Math.sin(cameraPitch),
    Math.cos(cameraYaw) * Math.cos(cameraPitch)
  ).multiplyScalar(dist);
  let camPos = targetPos.clone().add(offset);
  if(shakeT > 0){
    camPos.x += (Math.random()-0.5)*shakeMag;
    camPos.y += (Math.random()-0.5)*shakeMag;
    shakeT -= 0.016;
  }
  camera.position.lerp(camPos, 1);
  camera.lookAt(targetPos);
}

/* ---------------- main loop ---------------- */
function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(0.05, clock.getDelta());

  updatePlayer(dt);
  updateEnemy(dt);
  updateParticles(dt);
  updateCamera();
  updateInteractPrompt();

  // fireflies bob
  if(window._fireflies){
    const t = performance.now()*0.001;
    for(const f of window._fireflies){
      f.position.y = f.userData.base.y + Math.sin(t + f.userData.phase)*0.4;
      f.position.x = f.userData.base.x + Math.sin(t*0.4 + f.userData.phase)*0.6;
    }
  }

  // timers
  state.attackCD = Math.max(0, state.attackCD - dt);
  state.dodgeCD = Math.max(0, state.dodgeCD - dt);
  state.qCD = Math.max(0, state.qCD - dt);
  state.invuln = Math.max(0, state.invuln - dt);
  state.power = Math.min(state.powerMax, state.power + state.powerRegenRate*dt);
  if(state.comboTimer > 0){
    state.comboTimer -= dt;
    if(state.comboTimer <= 0){
      state.combo = 0;
      document.getElementById('combo-display').classList.remove('show');
    }
  }
  updateHPUI();
  updateResourceUI();

  renderer.render(scene, camera);
}
</script>
