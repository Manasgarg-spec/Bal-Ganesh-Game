<script type="module">
import * as THREE from 'three';

/* ============================================================
   GANESHA: RISE OF THE VIGHNAHARTA — prototype vertical slice
   Covers: story cinematic -> name entry -> 3D Sacred Forest hunt
   zone with movement/camera/combat/AI/clue system/local save.
   ============================================================ */

/* ---------------- Persistence ---------------- */
const SAVE_KEY = 'ganeshaGame_save_v1';
function loadSave(){
  try{ return JSON.parse(localStorage.getItem(SAVE_KEY)) || null; }catch(e){ return null; }
}
function writeSave(data){
  try{ localStorage.setItem(SAVE_KEY, JSON.stringify(data)); }catch(e){}
}
let save = loadSave() || { name:null, cluesFound:0, powerUnlocked:false };

/* ---------------- Screen flow ---------------- */
const titleScreen = document.getElementById('title-screen');
const btnBegin = document.getElementById('btn-begin');
const btnContinue = document.getElementById('btn-continue');
const cinematic = document.getElementById('cinematic');
const cineBg = document.getElementById('cine-bg');
const cineLabel = document.getElementById('cine-slide-label');
const cineText = document.getElementById('cine-text');
const nameScreen = document.getElementById('name-screen');
const nameForm = document.getElementById('name-form');
const nameInput = document.getElementById('name-input');
const hud = document.getElementById('hud');
const toastEl = document.getElementById('toast');

if(save.name){
  btnContinue.classList.remove('hidden');
  btnContinue.textContent = `Continue Quest, ${save.name}`;
}

function showToast(msg, ms=2600){
  toastEl.textContent = msg;
  toastEl.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(()=> toastEl.classList.remove('show'), ms);
}

const slides = [
  { label: 'Level 1 — Divine Creation', text: 'From clay and love, Parvati shapes a son, and breathes life where there was none.' },
  { label: 'Level 2 — Guardian of the Door', text: 'The boy stands watch at his mother\u2019s door, faithful to a single command.' },
  { label: 'Level 3 — Ganas Attack', text: 'Shiva\u2019s attendants come to force the door. The boy holds his ground.' },
  { label: 'Level 4–5 — Trials of Brahma and Indra', text: 'Wisdom and pride both test him, and both are turned aside.' },
  { label: 'Level 6 — Mahadev Encounter', text: 'Even Mahadev cannot pass. What follows is done, and cannot be undone.' },
  { label: 'Level 7 — Parvati\u2019s Divine Anger', text: 'A mother\u2019s grief shakes the three worlds. Shiva makes a vow: bring back a head, and life, before the sun turns.' },
  { label: 'Level 8 — The Divine Hunt', text: 'The Ganas scatter across forest, temple, cave, and mountain, in search of the one creature that faces north — a sacred elephant.' },
];
let slideIndex = 0;

function renderSlide(){
  const s = slides[slideIndex];
  cineLabel.textContent = s.label;
  cineText.textContent = s.text;
  cineBg.style.background = slideIndex % 2 === 0
    ? 'radial-gradient(ellipse at 50% 40%, #2b1330 0%, #0a0818 70%)'
    : 'radial-gradient(ellipse at 50% 40%, #1a2a3a 0%, #0a0818 70%)';
}
function advanceCinematic(){
  slideIndex++;
  if(slideIndex >= slides.length){
    cinematic.classList.add('hidden');
    cinematic.removeEventListener('click', advanceCinematic);
    startNameEntry();
    return;
  }
  renderSlide();
}
function startCinematic(){
  slideIndex = 0;
  renderSlide();
  cinematic.classList.remove('hidden');
  cinematic.addEventListener('click', advanceCinematic);
}
function startNameEntry(){
  nameScreen.classList.remove('hidden');
  nameInput.focus();
}

btnBegin.addEventListener('click', ()=>{
  titleScreen.classList.add('hidden');
  startCinematic();
});
btnContinue.addEventListener('click', ()=>{
  titleScreen.classList.add('hidden');
  enterWorld(save.name);
});
nameForm.addEventListener('submit', (e)=>{
  e.preventDefault();
  const val = nameInput.value.trim();
  if(!val) return;
  save.name = val.slice(0,18);
  writeSave(save);
  nameScreen.classList.add('hidden');
  showToast(`${save.name}, your divine quest begins.`, 3200);
  setTimeout(()=> enterWorld(save.name), 600);
});

/* ============================================================
   3D WORLD
   ============================================================ */
let renderer, scene, camera;
let player, playerMixerState = { vy:0, onGround:true };
let clock = new THREE.Clock();
let worldStarted = false;

const keys = {};
window.addEventListener('keydown', (e)=>{ keys[e.code]=true; onKeyDownGame(e); });
window.addEventListener('keyup', (e)=>{ keys[e.code]=false; });

let cameraYaw = Math.PI;
let cameraPitch = 0.35;
let camDistance = 7.5;
let isDragging = false;
let lastMouse = {x:0,y:0};

function enterWorld(name){
  document.getElementById('hud-name').textContent = name.toUpperCase();
  document.getElementById('clue-count').textContent = save.cluesFound;
  hud.classList.add('active');
  if(!worldStarted){
    initWorld(name);
    worldStarted = true;
    animate();
  }
}

/* ---- world state ---- */
const state = {
  playerHP: 100, playerMaxHP: 100,
  power: 100, powerMax: 100, powerRegenRate: 4,
  dodgeCD: 0, dodgeCDMax: 1.4,
  qCD: 0, qCDMax: 6,
  combo: 0, comboTimer: 0,
  attackCD: 0,
  invuln: 0,
  enemy: null,
  clueDropped: false,
  cluePickup: null,
  shrineUsed: false,
};

function initWorld(name){
  const canvasWrap = document.getElementById('canvas-wrap');
  renderer = new THREE.WebGLRenderer({ antialias:true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.shadowMap.enabled = true;
  canvasWrap.appendChild(renderer.domElement);

  scene = new THREE.Scene();
  const fogColor = 0x1b2d22;
  scene.fog = new THREE.FogExp2(fogColor, 0.028);
  scene.background = new THREE.Color(fogColor);

  camera = new THREE.PerspectiveCamera(55, window.innerWidth/window.innerHeight, 0.1, 500);

  // lights
  const hemi = new THREE.HemisphereLight(0x8fa885, 0x1a1408, 0.9);
  scene.add(hemi);
  const sun = new THREE.DirectionalLight(0xffdca8, 1.1);
  sun.position.set(20, 30, -10);
  sun.castShadow = true;
  sun.shadow.mapSize.set(2048,2048);
  sun.shadow.camera.left = -40; sun.shadow.camera.right = 40;
  sun.shadow.camera.top = 40; sun.shadow.camera.bottom = -40;
  scene.add(sun);

  // ground
  const groundGeo = new THREE.PlaneGeometry(220, 220, 1, 1);
  const groundMat = new THREE.MeshStandardMaterial({ color:0x24402c, roughness:1 });
  const ground = new THREE.Mesh(groundGeo, groundMat);
  ground.rotation.x = -Math.PI/2;
  ground.receiveShadow = true;
  scene.add(ground);

  addForestDecor();
  const statue = addAncientStatue(new THREE.Vector3(10, 0, -18));
  const shrine = addShrine(new THREE.Vector3(-14, 0, -10));

  player = buildPlayerModel();
  player.position.set(0,0,6);
  scene.add(player);

  const enemy = buildEnemyModel();
  enemy.position.set(6, 0, -14);
  scene.add(enemy);
  state.enemy = {
    mesh: enemy, hp: 60, maxHp: 60, alive:true,
    state:'idle', speed:2.6, detectRange:14, attackRange:2.0,
    attackCD:0, staggerT:0, home: enemy.position.clone(),
    patrolTarget: enemy.position.clone(),
  };

  // mouse look
  renderer.domElement.addEventListener('mousedown', (e)=>{ isDragging=true; lastMouse={x:e.clientX,y:e.clientY}; });
  window.addEventListener('mouseup', ()=> isDragging=false);
  window.addEventListener('mousemove', (e)=>{
    if(!isDragging) return;
    const dx = e.clientX - lastMouse.x;
    const dy = e.clientY - lastMouse.y;
    lastMouse = {x:e.clientX, y:e.clientY};
    cameraYaw -= dx * 0.005;
    cameraPitch = Math.max(0.08, Math.min(0.9, cameraPitch - dy*0.004));
  });
  renderer.domElement.addEventListener('click', ()=> attack(false));
  renderer.domElement.addEventListener('contextmenu', (e)=>{ e.preventDefault(); attack(true); });

  window.addEventListener('resize', onResize);
}

function onResize(){
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
}

/* ---------------- decor ---------------- */
function addForestDecor(){
  const trunkMat = new THREE.MeshStandardMaterial({ color:0x4a3527, roughness:1 });
  const leafMat = new THREE.MeshStandardMaterial({ color:0x2f5a3a, roughness:.9 });
  for(let i=0;i<70;i++){
    const angle = Math.random()*Math.PI*2;
    const r = 14 + Math.random()*85;
    const x = Math.cos(angle)*r, z = Math.sin(angle)*r;
    const h = 3 + Math.random()*3.5;
    const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.25,0.35,h,6), trunkMat);
    trunk.position.set(x, h/2, z);
    trunk.castShadow = true;
    scene.add(trunk);
    const leaf = new THREE.Mesh(new THREE.ConeGeometry(1.6+Math.random(), 3.2+Math.random(), 7), leafMat);
    leaf.position.set(x, h+1.6, z);
    leaf.castShadow = true;
    scene.add(leaf);
  }
  // fireflies
  const fireflyGeo = new THREE.SphereGeometry(0.06,6,6);
  const fireflyMat = new THREE.MeshBasicMaterial({ color:0xf0e08a });
  window._fireflies = [];
  for(let i=0;i<26;i++){
    const f = new THREE.Mesh(fireflyGeo, fireflyMat);
    f.position.set((Math.random()-0.5)*50, 1+Math.random()*2.5, (Math.random()-0.5)*50);
    f.userData.phase = Math.random()*Math.PI*2;
    f.userData.base = f.position.clone();
    scene.add(f);
    window._fireflies.push(f);
  }
}

function addAncientStatue(pos){
  const g = new THREE.Group();
  const baseMat = new THREE.MeshStandardMaterial({ color:0x6b6255, roughness:1 });
  const base = new THREE.Mesh(new THREE.CylinderGeometry(1.1,1.3,1,8), baseMat);
  base.position.y = 0.5;
  const pillar = new THREE.Mesh(new THREE.CylinderGeometry(0.7,0.8,3.2,8), baseMat);
  pillar.position.y = 2.6;
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.9,10,10), baseMat);
  head.position.y = 4.6;
  g.add(base, pillar, head);
  g.position.copy(pos);
  g.traverse(o=>{ if(o.isMesh){ o.castShadow=true; o.receiveShadow=true; } });
  scene.add(g);
  return g;
}

function addShrine(pos){
  const glowGeo = new THREE.CircleGeometry(1.6, 24);
  const glowMat = new THREE.MeshBasicMaterial({ color:0xd9a441, transparent:true, opacity:0.35, side:THREE.DoubleSide });
  const glow = new THREE.Mesh(glowGeo, glowMat);
